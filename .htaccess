RewriteEngine on

# static files are served straight from disk (this is what lets the PWA shell,
# the manifest and the service worker resolve at all)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L]

<IfModule mod_mime.c>
    # a manifest served as text/plain is refused by Chrome
    AddType application/manifest+json .webmanifest
    AddType application/json .json
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin *
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Content-Type-Options "nosniff"
    # versioned, fingerprint-free assets: a year is safe because the service
    # worker fetches the shell with cache: 'reload'
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # ordering matters: these come *after* the immutable rule above, because
    # the last matching Header set wins - a cached sw.js is a stuck deploy
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
        # the worker scope must stay at the document root
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
    <FilesMatch "manifest\.(json|webmanifest)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/json application/javascript
</IfModule>

# never expose the framework or the data dump
<FilesMatch "^(database\.sql|README\.md|BRIEF\.md|render\.yaml|Dockerfile|LICENSE)$">
    Require all denied
</FilesMatch>

DirectoryIndex index.php index.html
