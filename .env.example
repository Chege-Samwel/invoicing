# Adomin Invoices — example environment (copy to .env for local dev,
# or set these in Render -> Environment for hosting).
# Never commit a real .env with passwords.
#
# Database (MySQL-compatible only: TiDB Cloud, Aiven, MariaDB, ...).
# For TiDB Cloud Serverless, copy the values EXACTLY from the Connect
# dialog (Clusters -> your cluster -> Connect -> General -> Public):
#   DB_HOST  gateway01.<region>.prod.aws.tidbcloud.com
#   DB_USER  <prefix>.root  (older clusters: root@<cluster-id>)
#   DB_PASS  the database password
#   DB_NAME  adomin
#   DB_PORT  4000 (TiDB) or 3306 (plain MySQL/MariaDB)
#   DB_SSL   1 (mandatory on TiDB Serverless)
DB_HOST=localhost
DB_USER=root
DB_PASS=toor
DB_NAME=test
DB_PORT=3306
DB_SSL=0
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# DB_SSL_VERIFY=0
# DATABASE_URL=mysql://user:pass@host:4000/adomin?ssl-mode=REQUIRED

# App environment: production hides errors; development shows them (debugging only).
APP_ENV=production

# Database initialisation on container start (Docker/Render only):
# 1 = create schema + import database.sql when empty, and repair primary keys
#     that TiDB refused to give an AUTO_INCREMENT counter (error 8200);
# 0 = manual import only (then run: php database/tidb-fix-increments.php).
ADOMIN_AUTO_IMPORT=1
# 0 = do not repair primary keys whose AUTO_INCREMENT TiDB refused (only if you
#     are fixing them yourself with php database/tidb-fix-increments.php).
# ADOMIN_FIX_AUTO_INCREMENT=1

# Optional: unlocks the detailed report at /status.php?token=<value>
# (host, TLS mode, the exact MySQL error, initialiser log). Unset = health only.
# STATUS_TOKEN=change-me-to-a-long-random-string

# PDF engine: dompdf (pure PHP, any host) or wkhtmltopdf (needs the binary).
PDF_ENGINE=dompdf

# Branding / locale (defaults already suit Kenya; override as needed).
# ADOMIN_BRAND_NAME=Adomin Technologies
# ADOMIN_APP_NAME=Adomin Invoices
# ADOMIN_TIMEZONE=Africa/Nairobi
# ADOMIN_CURRENCY=KES
# ADOMIN_DATE_FORMAT=d.m.Y
