{
  "name": "Adomin Invoices — invoicing & warehouse management",
  "short_name": "Adomin",
  "description": "Issue tax invoices, pro-forma, debit and credit notes as PDF, send them with a link, and track stock across your warehouses. By Adomin Technologies, Nairobi.",
  "id": "ke-adomin-invoices",
  "start_url": "./user",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#0b6bcb",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    {
      "src": "./assets/public/imgs/icons/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/public/imgs/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/public/imgs/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/public/imgs/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New invoice",
      "short_name": "New",
      "url": "./user/new/invoice",
      "icons": [{ "src": "./assets/public/imgs/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Invoices",
      "short_name": "Invoices",
      "url": "./user/invoices",
      "icons": [{ "src": "./assets/public/imgs/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Stock",
      "short_name": "Stock",
      "url": "./user/store/stocks",
      "icons": [{ "src": "./assets/public/imgs/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "adomin": {
    "brand": "Adomin Technologies",
    "support": "support@adomin.co.ke",
    "timezone": "Africa/Nairobi",
    "currency": "KES",
    "notes": "prefer_related_applications stays false until the Play Store listing exists; flip it to true and add the package name ke.co.adomin.invoices once published, so Android users get the native app prompt instead of the PWA."
  }
