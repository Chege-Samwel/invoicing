# Adomin Technologies — deployment image for this CodeIgniter 3 invoicing app.
#
# Built for the Render FREE tier (0.1 CPU, 512 MB RAM, no persistent disk,
# sleeps after 15 idle minutes), so:
#   * PHP 7.4 (CI 3.1.13 is not PHP 8 clean) with only the extensions needed;
#   * NO wkhtmltopdf: PDFs are generated by the bundled dompdf (pure PHP), which
#     is why the PDF download works on a free instance at all;
#   * the font cache and upload dirs are writable, because the free tier
#     filesystem is ephemeral and nothing may try to write elsewhere;
#   * mpm_prefork with a small worker count — 512 MB does not fit many Apache
#     children and one busy child is exactly what dead-locked the old PDF code.
#
# Want wkhtmltopdf anyway (sharper CSS on a VPS)?  docker build --build-arg WITH_WKHTMLTOPDF=1 .
# and set PDF_ENGINE=wkhtmltopdf.

FROM php:7.4-apache

ARG WITH_WKHTMLTOPDF=0

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpng-dev libjpeg-dev libfreetype6-dev \
        libzip-dev libxml2-dev \
        git unzip libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" mysqli gd mbstring xml zip exif intl \
    && a2enmod rewrite headers expires deflate \
    && if [ "$WITH_WKHTMLTOPDF" = "1" ]; then apt-get install -y --no-install-recommends wkhtmltopdf xvfb; fi \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY . /var/www/html/
WORKDIR /var/www/html

# Everything the app writes to: uploads, CI cache/logs, dompdf temp + fonts.
RUN mkdir -p attachments/companiesimages attachments/featuresimages attachments/blogimages \
        application/cache application/logs application/cache/dompdf \
    && chmod -R 777 attachments application/cache application/logs application/libraries/dompdf/lib/fonts \
    && chown -R www-data:www-data attachments application/cache application/logs \
    && rm -f pdfs.log

# Apache: 2-4 children is all 512 MB can hold; keep .htaccess working.
RUN { \
      echo '<IfModule mpm_prefork_module>'; \
      echo '    ServerLimit           4'; \
      echo '    StartServers          2'; \
      echo '    MinSpareThreads       2'; \
      echo '    MaxSpareThreads       4'; \
      echo '    MaxRequestWorkers     4'; \
      echo '    MaxConnectionsPerChild 3000'; \
      echo '</IfModule>'; \
    } > /etc/apache2/conf-enabled/adomin-mpm.conf \
    && sed -i 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf \
    && sed -i 's/^Listen 80$/Listen 80/' /etc/apache2/ports.conf \
    && echo "ServerName localhost" >> /etc/apache2/apache2.conf

# PHP: dompdf needs room for a long invoice; 64M memory and 120s timeout.
RUN { \
      echo 'memory_limit = 256M'; \
      echo 'max_execution_time = 120'; \
      echo 'max_input_vars = 5000'; \
      echo 'post_max_size = 25M'; \
      echo 'upload_max_filesize = 20M'; \
      echo 'date.timezone = Africa/Nairobi'; \
      echo 'expose_php = Off'; \
    } > /usr/local/etc/php/conf.d/adomin.ini

EXPOSE 80

ENV WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf \
    PDF_ENGINE=dompdf \
    ADOMIN_PDF_TMP=/tmp \
    PHP_OPCACHE_ENABLE=1

CMD ["apache2-foreground"]
