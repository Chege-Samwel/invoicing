

# Adomin: local tooling and build output (never commit)
.tools/
.cache/
node_modules/
android-app/node_modules/
android-app/android/
android-app/*.keystore
android-app/*.jks
android-app/AdominInvoices*.apk
*.log
.DS_Store
# ephemeral uploads on free hosting (keep the folder, ignore contents except
# committed default logos: attachments/companiesimages/**/logo.png)
attachments/**/*
!attachments/**/
!attachments/**/logo.png
# dompdf runtime cache + CI cache/logs
application/cache/**
!application/cache/.gitkeep
application/logs/**
!application/logs/.gitkeep

# dompdf regenerates font metrics on the first render; the committed DejaVu set
# is authoritative, so generated files should not show up as new work
application/libraries/dompdf/lib/fonts/dejavu_sans_*_*.ttf
application/libraries/dompdf/lib/fonts/dejavu_sans_*_*.ufm
application/libraries/dompdf/lib/fonts/dejavu_sans_*_*.ufm.php
.preview/
# dev-only symlink used when running the document tests locally
tests/document/node_modules
tests/document/page-*.html
